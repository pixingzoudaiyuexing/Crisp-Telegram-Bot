bot:
  # Bot Token
  token: 1234:1234567890abcdef
  # 发送至群
  groupId: 0
crisp:
  # 插件 ID
  id:
  # 插件秘钥
  key:
  # 网站 ID
  website:
easyimages:
  apiUrl: "http://127.0.0.1/api/index.php"
  apiToken: "token"
learning:
  # 记录用户问题、AI 回复、人工回复，用于后续人工整理 FAQ；会做基础脱敏
  enabled: true
  logPath: data/learning_logs.jsonl
replyUser:
  # 人工客服发送到 Crisp 时显示的名字和头像
  operatorNickname: 人工客服
  operatorAvatar: https://bpic.51yuansu.com/pic3/cover/03/47/92/65e3b3b1eb909_800.jpg
  # AI 自动回复发送到 Crisp 时显示的名字和头像
  aiNickname: 智能客服
  aiAvatar: https://img.ixintu.com/download/jpg/20210125/8bff784c4e309db867d43785efde1daf_512_512.jpg
autoreply:
  # 自动关键词回复，你可以复制成多行，每个关键词用 `|` 隔开即可，在 `:` 后输入自动回复内容
  "在吗|你好": "欢迎使用客服系统，请等待客服回复你~"
openai:
  # 第三方兼容 OpenAI Chat Completions 的 API 地址，需要包含 /v1
  # 例如：https://api.openai.com/v1 或 https://你的域名/v1
  baseUrl: https://api.openai.com/v1
  # APIKey
  apiKey: 
  # 模型名称，按你的第三方 API 支持的模型填写
  model: gpt-3.5-turbo
  # 预制内容，内容越多token消耗越多，单价越贵
  payload: |
    作为简体中文客服，请始终以温柔、耐心的态度回复所有消息，确保每次交互中用户感受到尊重和理解。
    请仅使用纯文本回复，不得使用其他语言或格式化语法。
    积极倾听用户的问题，耐心询问细节，并提供清晰、详细的回答或指导。
    优先参考提供的内容，以提供准确解答；若知识库无相关信息，再深入思考找到适合的回答。
    在每次互动中，确保为用户提供友好、积极的支持体验。
